<Window x:Class="Yaromir_Firewall_FINAL1.AchievementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Достижения" Height="500" Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Состояние 1: нет достижений -->
        <Border x:Name="EmptyPanel" Grid.Row="1"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                Background="{DynamicResource BackgroundBrush}">
            <TextBlock x:Name="EmptyText" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Состояние 2: список достижений -->
        <ScrollViewer x:Name="AchievementsPanel" Grid.Row="1" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Достижение: Ветеран -->
                <Border x:Name="VeteranBorder" Visibility="Collapsed"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                        Background="{DynamicResource BackgroundBrush}"
                        Padding="5" Margin="0,0,0,10">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🏅" FontSize="48"
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="VeteranTitle" FontSize="20" FontWeight="Bold"
                                           Margin="0,0,0,5"/>
                                <TextBlock x:Name="VeteranDescription" FontSize="13"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock x:Name="VeteranUnlocked" FontSize="12"
                                           Foreground="{DynamicResource StatusBrush}"
                                           HorizontalAlignment="Right" FontStyle="Italic"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <!-- Достижение: Опытный воин -->
                <Border x:Name="WarriorBorder" Visibility="Collapsed"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                        Background="{DynamicResource BackgroundBrush}"
                        Padding="5" Margin="0,0,0,10">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="⚔️" FontSize="48"
                                       VerticalAlignment="Center" Margin="0,0,15,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="WarriorTitle" FontSize="20" FontWeight="Bold"
                                           Margin="0,0,0,5"/>
                                <TextBlock x:Name="WarriorDescription" FontSize="13"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock x:Name="WarriorUnlocked" FontSize="12"
                                           Foreground="{DynamicResource StatusBrush}"
                                           HorizontalAlignment="Right" FontStyle="Italic"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>