<Window x:Class="Yaromir_Firewall_FINAL1.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Language Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="LanguageLabel" Text="Language / Язык:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <ComboBox x:Name="LanguageComboBox" Width="200" HorizontalAlignment="Left" SelectionChanged="LanguageComboBox_SelectionChanged">
                <ComboBoxItem Content="Русский" Tag="ru"/>
                <ComboBoxItem Content="English" Tag="en"/>
            </ComboBox>
        </StackPanel>

        <!-- Theme Section -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock x:Name="ThemeLabel" Text="Theme / Тема:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <ComboBox x:Name="ThemeComboBox" Width="200" HorizontalAlignment="Left" SelectionChanged="ThemeComboBox_SelectionChanged">
                <ComboBoxItem Content="System / Системная" Tag="2"/>
                <ComboBoxItem Content="Light / Светлая" Tag="0"/>
                <ComboBoxItem Content="Dark / Тёмная" Tag="1"/>
            </ComboBox>
        </StackPanel>

        <!-- Auto-start Section -->
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <CheckBox x:Name="AutoStartCheckBox" Content="Run at startup / Автозапуск при старте системы" 
                      FontSize="14" Checked="AutoStartCheckBox_Checked" Unchecked="AutoStartCheckBox_Unchecked"/>
        </StackPanel>

        <!-- Info Section -->
        <StackPanel Grid.Row="3" Margin="0,0,0,20">
            <TextBlock x:Name="InfoLabel" Text="Settings will be saved automatically." 
                       FontSize="12" FontStyle="Italic" Foreground="#666" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Close Button -->
        <Button Grid.Row="5" Content="Close / Закрыть" Width="120" Height="35" 
                HorizontalAlignment="Right" Click="CloseButton_Click"
                Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
    </Grid>
</Window>
