<Window x:Class="Yaromir_Firewall_FINAL1.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="750" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Настройки" FontSize="18" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <!-- Базовые настройки -->
            <TextBlock Text="Тема:" FontSize="14" 
                       HorizontalAlignment="Left" Margin="0,0,0,5"/>
            <ComboBox x:Name="ThemeComboBox" Width="250" Margin="0,0,0,10" HorizontalAlignment="Left">
                <ComboBoxItem Content="Светлая" Tag="0"/>
                <ComboBoxItem Content="Тёмная" Tag="1"/>
                <ComboBoxItem Content="Системная" Tag="2"/>
                <ComboBoxItem Content="Неон" Tag="3"/>
                <ComboBoxItem Content="Золотая" Tag="4"/>
            </ComboBox>

            <TextBlock Text="Язык:" FontSize="14" 
                       HorizontalAlignment="Left" Margin="0,0,0,5"/>
            <ComboBox x:Name="LanguageComboBox" Width="250" Margin="0,0,0,20" HorizontalAlignment="Left">
                <ComboBoxItem Content="Русский" Tag="true"/>
                <ComboBoxItem Content="Английский" Tag="false"/>
            </ComboBox>

            <Separator Margin="0,0,0,15"/>

            <!-- Правила портов для программ -->
            <TextBlock Text="Правила портов для программ" FontSize="16" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <!-- Список программ -->
            <TextBlock Text="Программы:" FontSize="14" Margin="0,0,0,5"/>
            <ListBox x:Name="ProgramsListBox" Width="250" Height="120" Margin="0,0,0,5"
                     HorizontalAlignment="Left" SelectionChanged="ProgramsListBox_SelectionChanged"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBox x:Name="NewProgramTextBox" Width="170" Margin="0,0,5,0"
                         ToolTip="Введите имя программы (например, chrome.exe)"/>
                <Button Content="Добавить" Width="75" Margin="0,0,5,0" Click="AddProgram_Click"/>
                <Button Content="Удалить" Width="75" Click="RemoveProgram_Click"/>
            </StackPanel>

            <!-- Порты выбранной программы -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Разрешённые порты:" FontSize="13" Margin="0,0,0,5"/>
                    <ListBox x:Name="AllowedPortsListBox" Height="100"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Запрещённые порты:" FontSize="13" Margin="0,0,0,5"/>
                    <ListBox x:Name="BlockedPortsListBox" Height="100"/>
                </StackPanel>
            </Grid>

            <!-- Добавление порта -->
            <TextBlock Text="Добавить / удалить порт:" FontSize="14" Margin="0,10,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBox x:Name="PortTextBox" Width="100" Margin="0,0,5,0"
                         PreviewTextInput="PortTextBox_PreviewTextInput"
                         ToolTip="Введите номер порта (1-65535)"/>
                <Button Content="Разрешить" Width="90" Margin="0,0,5,0" Click="AllowPort_Click"/>
                <Button Content="Запретить" Width="90" Margin="0,0,5,0" Click="BlockPort_Click"/>
                <Button Content="Удалить" Width="75" Click="RemovePort_Click"/>
            </StackPanel>

            <Separator Margin="0,15,0,15"/>

            <Button Content="Сохранить" Width="100" Height="30" 
                    HorizontalAlignment="Center" Click="Save_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
