<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary x:Key="LightTheme">
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#BBBBBB"/>
        <SolidColorBrush x:Key="StatusBrush" Color="#666666"/>
    </ResourceDictionary>

    <ResourceDictionary x:Key="DarkTheme">
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#4A4A4A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#555555"/>
        <SolidColorBrush x:Key="StatusBrush" Color="#AAAAAA"/>
    </ResourceDictionary>

    <ResourceDictionary x:Key="NeonTheme">
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0A0A1A"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#00FFCC"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#1A1A3A"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#2A2A5A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#00FFCC"/>
        <SolidColorBrush x:Key="StatusBrush" Color="#66FFDD"/>
    </ResourceDictionary>

    <ResourceDictionary x:Key="GoldTheme">
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1A1208"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#FFD700"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#2A1F0A"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#4A3510"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FFD700"/>
        <SolidColorBrush x:Key="StatusBrush" Color="#FFE44D"/>
    </ResourceDictionary>

</ResourceDictionary>