<Window x:Class="Yaromir_Firewall_FINAL1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yaromir Firewall" Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Единый стиль для всех кнопок верхней панели -->
        <Style x:Key="InfoButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для кнопок в центре -->
        <Style x:Key="CenterButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="200"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="ThemeButton" Style="{StaticResource InfoButtonStyle}" Click="ThemeButton_Click" Content="☀️"/>
            <Button x:Name="LangButton" Style="{StaticResource InfoButtonStyle}" Click="LangButton_Click" Content="🇷🇺" Margin="5,0,0,0"/>
            <Button x:Name="AboutButton" Style="{StaticResource InfoButtonStyle}" Content="i" Click="OpenAbout_Click" Margin="5,0,0,0"/>
            <Button x:Name="SettingsButton" Style="{StaticResource InfoButtonStyle}" Click="OpenSettings_Click" Content="⚙️" Margin="5,0,0,0"/>
            <Button x:Name="AchievementsButton" Style="{StaticResource InfoButtonStyle}" Click="OpenAchievements_Click" Content="🏆" Margin="5,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="AppIcon" Source="Resources/icon.ico" Stretch="Uniform" Width="110" Height="110" Margin="0,0,0,20"/>
            <Button x:Name="OpenMonitorButton" Style="{StaticResource CenterButtonStyle}" Height="40" FontSize="16" Click="OpenMonitor_Click"/>
            <Button x:Name="WhiteListButton" Style="{StaticResource CenterButtonStyle}" Height="35" Click="OpenWhiteList_Click"/>
            <Button x:Name="BlackListButton" Style="{StaticResource CenterButtonStyle}" Height="35" Click="OpenBlackList_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="2" HorizontalAlignment="Center" FontSize="12" Margin="0,5"
                   Foreground="{DynamicResource StatusBrush}"/>
        <TextBlock x:Name="LicenseLine" Grid.Row="3" HorizontalAlignment="Center" FontSize="9" Margin="0,5,0,0" Foreground="Gray"/>
    </Grid>
</Window>