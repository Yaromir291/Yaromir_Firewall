<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Yaromir_Firewall_FINAL1</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateResourceUsePreserializedResources>false</GenerateResourceUsePreserializedResources>

    <!-- Единый источник правды о версии.
         БЫЛО: версия нигде не задавалась, и .exe в свойствах показывал 1.0.0.0,
         хотя продукт — 2.0. Это же значение читает SettingsManager.CurrentVersion,
         а позже его будет сравнивать автообновление. -->
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="AboutWindow.xaml" />
    <None Remove="AchievementsWindow.xaml" />
    <None Remove="Resources\bg_silver.jpg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\bg_silver.jpg" />
    <Resource Include="Resources\icon.ico" />
    <Resource Include="Resources\bg_neon.jpg" />
    <Resource Include="Resources\bg_gold.jpg" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Compile Include="AboutWindow.xaml.cs" />
    <Compile Include="AchievementFlags.cs" />
    <Compile Include="AchievementsWindow.xaml.cs" />
    <Compile Include="App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
    <Compile Include="Localization.cs" />
    <Page Include="AboutWindow.xaml" />
    <Page Include="AchievementsWindow.xaml" />

    <Page Include="MainWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>

    <Page Include="MonitorWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="MonitorWindow.xaml.cs">
      <DependentUpon>MonitorWindow.xaml</DependentUpon>
    </Compile>

    <Page Include="WhiteListWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="WhiteListWindow.xaml.cs">
      <DependentUpon>WhiteListWindow.xaml</DependentUpon>
    </Compile>

    <Page Include="BlackListWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="BlackListWindow.xaml.cs">
      <DependentUpon>BlackListWindow.xaml</DependentUpon>
    </Compile>

    <Page Include="PromptWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="PromptWindow.xaml.cs">
      <DependentUpon>PromptWindow.xaml</DependentUpon>
    </Compile>

    <Page Include="SettingsWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="SettingsWindow.xaml.cs">
      <DependentUpon>SettingsWindow.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="themes.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Services\AppLog.cs" />
    <Compile Include="Services\AutostartManager.cs" />
    <Compile Include="Services\FirewallService.cs" />
    <Compile Include="Services\NetshRunner.cs" />
    <Compile Include="Services\NetworkMonitor.cs" />
    <Compile Include="Services\SettingsManager.cs" />
    <Compile Include="Models\ConnectionInfo.cs" />
    <Compile Include="Models\ProgramPortRule.cs" />
    <Compile Include="AssemblyInfo.cs" />
  </ItemGroup>

</Project>